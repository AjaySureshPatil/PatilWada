3},"name":"_default"},{"generated":{"line":43,"column":26},"source":"src/component/ItemList.js","original":{"line":40,"column":23}}],"sources":{"src/component/ItemList.js":"import { useDispatch } from \"react-redux\";\nimport { addItem } from \"../utils/cartSlice\";\nimport {CDN_URL  } from \"../utils/constant\";\n\nconst ItemList=({items})=>{\n\n    const dispatch=useDispatch();\n    const handleAddItems=(item)=>{\n          dispatch(addItem(item));\n    }\n return(\n       <div className=\"\">\n            {items.map((item)=>(\n            <div \n            data-testid=\"foodItems\"\n            className=\"p-2 m-2 border-b-2 border-200 text-left flex justify-between\"\n             key={item.card.info.id}>\n                <div className=\"py-1\">\n                    <span>{item.card.info.name}</span> \n                    <span> - ₹{item.card.info.price\n                    ? item.card.info.price/100 \n                    : item.card.info.defaultPrice/100}</span>\n                    <p className=\"text-xs w-96\">{item.card.info.description}</p>\n                </div>\n                <div className=\"\"> \n\n                    <div className=\"absolute\">\n                        <button className=\" p-1 mx-7 text-sm bg-white shadow-lg text-green-800 mt-12 ml-8 \" \n                        onClick={()=>handleAddItems(item)}>Add  +</button>\n                    </div>\n                    <img className=\"w-32 h-20\" src={CDN_URL + item.card.info.imageId}  />\n                </div>\n\n            </div>\n\n            ))}\n       </div>\n )\n}\nexport default ItemList;"},"lineCount":null}},"error":null,"hash":"f2d72f4ec0f4fb6054e469edd74b438e","cacheData":{"env":{}}}